rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }
    match /clans/{clanId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.memberCount == 1;
      allow update: if signedIn() && (
        resource.data.leaderId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount <= 30
          && request.resource.data.memberCount >= 0
          && (request.resource.data.memberCount == resource.data.memberCount + 1
              || request.resource.data.memberCount == resource.data.memberCount - 1)) ||
        (exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','influence'])
          && request.resource.data.rating >= resource.data.rating - 40
          && request.resource.data.rating <= resource.data.rating + 40
          && request.resource.data.influence >= resource.data.influence - 3
          && request.resource.data.influence <= resource.data.influence + 3)
      );
      allow delete: if signedIn() && resource.data.leaderId == request.auth.uid && resource.data.memberCount <= 1;
      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid) && request.resource.data.uid == uid;
        allow update: if isSelf(uid) || get(/databases/$(database)/documents/clans/$(clanId)).data.leaderId == request.auth.uid;
        allow delete: if isSelf(uid) || get(/databases/$(database)/documents/clans/$(clanId)).data.leaderId == request.auth.uid;
      }
    }
    match /battleHistory/{battleId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.participantUids is list
        && request.auth.uid in request.resource.data.participantUids;
      allow update, delete: if false;
    }
  }
}
