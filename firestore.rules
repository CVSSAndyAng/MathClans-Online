rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'student';
      allow update: if isAdmin() || (isSelf(uid) && (
                    !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['uid','email','role','moderation','createdAt']) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
                     && !request.resource.data.keys().hasAny(['email']))));
      allow delete: if false;
    }

    match /privateProfiles/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update: if isAdmin() || isSelf(uid);
      allow delete: if false;
    }

    match /clans/{clanId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.memberCount == 1;
      allow update: if isAdmin() || (signedIn() && (
        (resource.data.leaderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','nameLower','region','guardian','updatedAtMs'])) ||
        (resource.data.leaderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['leaderId','memberCount'])
          && request.resource.data.memberCount >= 1
          && request.resource.data.memberCount <= 30) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount <= 30
          && request.resource.data.memberCount >= 0
          && (request.resource.data.memberCount == resource.data.memberCount + 1
              || request.resource.data.memberCount == resource.data.memberCount - 1)) ||
        (exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','influence'])
          && request.resource.data.rating >= resource.data.rating - 40
          && request.resource.data.rating <= resource.data.rating + 40
          && request.resource.data.influence >= resource.data.influence - 3
          && request.resource.data.influence <= resource.data.influence + 3)
      ));
      allow delete: if isAdmin() || (signedIn() && resource.data.leaderId == request.auth.uid && resource.data.memberCount <= 1);

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && (request.resource.data.role == 'member'
              || get(/databases/$(database)/documents/clans/$(clanId)).data.leaderId == uid);
        allow update: if isAdmin()
          || (isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','avatar']))
          || get(/databases/$(database)/documents/clans/$(clanId)).data.leaderId == request.auth.uid;
        allow delete: if isAdmin() || isSelf(uid)
          || get(/databases/$(database)/documents/clans/$(clanId)).data.leaderId == request.auth.uid;
      }
    }

    match /battleHistory/{battleId} {
      allow read: if isAdmin() || (signedIn()
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids);
      allow create: if signedIn()
        && request.resource.data.participantUids is list
        && request.auth.uid in request.resource.data.participantUids;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
