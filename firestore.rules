rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function activeAdmin() { return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false; }
    function clanLeader(clanId) { return signedIn() && get(/databases/$(database)/documents/clans/$(clanId)).data.leaderId == request.auth.uid; }
    function clanMember(clanId) { return signedIn() && exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)); }
    function applicantApprovedByLeader(clanId, uid) { return clanLeader(clanId) && exists(/databases/$(database)/documents/clans/$(clanId)/joinRequests/$(uid)); }
    function chatAllowed() {
      let p = get(/databases/$(database)/documents/players/$(request.auth.uid)).data;
      return signedIn() && (!p.keys().hasAny(['moderation']) || ((!p.moderation.keys().hasAny(['chatMuted']) || p.moderation.chatMuted != true) && (!p.moderation.keys().hasAny(['status']) || p.moderation.status != 'suspended')));
    }
    function validChat() { return request.resource.data.senderUid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 240; }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || activeAdmin());
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && request.resource.data.uid == uid && request.resource.data.role == 'student';
      allow update: if activeAdmin()
        || (isSelf(uid) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid','email','role','moderation','createdAt'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']) && !request.resource.data.keys().hasAny(['email']))))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clanId','clanRole','updatedAtMs'])
          && request.resource.data.clanRole == 'member'
          && request.resource.data.clanId is string
          && applicantApprovedByLeader(request.resource.data.clanId, uid));
      allow delete: if false;
    }

    match /privateProfiles/{uid} {
      allow read, create, update: if activeAdmin() || isSelf(uid);
      allow delete: if false;
    }

    match /clans/{clanId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.leaderId == request.auth.uid && request.resource.data.memberCount == 1;
      allow update: if activeAdmin() || (signedIn() && (
        (resource.data.leaderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','nameLower','region','guardian','updatedAtMs'])) ||
        (resource.data.leaderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaderId','memberCount']) && request.resource.data.memberCount >= 1 && request.resource.data.memberCount <= 30) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) && request.resource.data.memberCount <= 30 && request.resource.data.memberCount >= 0 && ((clanLeader(clanId) && request.resource.data.memberCount == resource.data.memberCount + 1) || (clanMember(clanId) && request.resource.data.memberCount == resource.data.memberCount - 1))) ||
        (clanMember(clanId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','influence']) && request.resource.data.rating >= resource.data.rating - 40 && request.resource.data.rating <= resource.data.rating + 40 && request.resource.data.influence >= resource.data.influence - 3 && request.resource.data.influence <= resource.data.influence + 3)
      ));
      allow delete: if activeAdmin() || (signedIn() && resource.data.leaderId == request.auth.uid && resource.data.memberCount <= 1);

      match /joinRequests/{uid} {
        allow read: if activeAdmin() || isSelf(uid) || clanLeader(clanId);
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && get(/databases/$(database)/documents/players/$(uid)).data.clanId == null;
        allow update: if clanLeader(clanId) || (isSelf(uid) && request.resource.data.status == 'pending');
        allow delete: if activeAdmin() || isSelf(uid) || clanLeader(clanId);
      }

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if (isSelf(uid) && request.resource.data.uid == uid && get(/databases/$(database)/documents/clans/$(clanId)).data.leaderId == uid)
          || (clanLeader(clanId) && request.resource.data.uid == uid && exists(/databases/$(database)/documents/clans/$(clanId)/joinRequests/$(uid)));
        allow update: if activeAdmin()
          || (isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','avatar']))
          || (clanLeader(clanId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
        // V2.1: clan leaders cannot remove established members. Members leave only by deleting themselves.
        allow delete: if activeAdmin() || isSelf(uid);
      }

      match /chat/{messageId} {
        allow read: if activeAdmin() || clanMember(clanId);
        allow create: if clanMember(clanId) && chatAllowed() && validChat() && request.resource.data.channelType == 'clan' && request.resource.data.clanId == clanId;
        allow update, delete: if false;
      }
    }

    match /chatMain/{messageId} {
      allow read: if signedIn();
      allow create: if chatAllowed() && validChat() && request.resource.data.channelType == 'main' && request.resource.data.clanId == null;
      allow update, delete: if false;
    }

    match /battleHistory/{battleId} {
      allow read: if activeAdmin() || (signedIn() && resource.data.participantUids is list && request.auth.uid in resource.data.participantUids);
      allow create: if signedIn() && request.resource.data.participantUids is list && request.auth.uid in request.resource.data.participantUids;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if activeAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update: if activeAdmin();
      allow delete: if false;
    }
  }
}
